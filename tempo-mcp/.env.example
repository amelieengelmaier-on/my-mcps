# Tempo API token
# Get from: Tempo (in Jira) -> Settings -> API Integration -> Create token
# Scopes needed: View worklogs + Manage worklogs
TEMPO_API_TOKEN=

# Your Atlassian account ID
# Find it at: https://on-running.atlassian.net/rest/api/3/myself (open in browser while logged in, copy the accountId field)
TEMPO_ACCOUNT_ID=
